{
  "name": "dunah-ide",
  "productName": "Dunah IDE",
  "version": "1.0.0",
  "description": "Dunah IDE - Monaco-based IDE with GitHub and Ollama",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
